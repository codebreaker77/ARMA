include LICENSE
include README.md
include pyproject.toml
include .pre-commit-hooks.yaml

recursive-include arma_veto *.py

prune data
prune experiments
prune tests
prune docs
prune .agents
prune .gemini
prune layer
exclude *.parquet
exclude *.jsonl
exclude *.bak
exclude *.csv
global-exclude *.py[cod] __pycache__ *.so
